config {
    type: "table",
    name: "dim_payment",
    tags: ["dimensions"]
}

SELECT
  1 AS payment_id,
  'Credit card' AS payment_detail
UNION ALL
SELECT
  2,
  'Cash'
UNION ALL
SELECT
  3,
  'No charge'
UNION ALL
SELECT
  4,
  'Dispute'
UNION ALL
SELECT
  5,
  'Unknown'
UNION ALL
SELECT
  6,
  'Voided trip'